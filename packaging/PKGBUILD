# Maintainer: S-Mas
pkgname=chemcraft
pkgver=0.4.0
pkgrel=1
pkgdesc="Local-first clean-room 2D vector molecular design & SAR studio integrated with AdmetCraft"
arch=('x86_64')
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc' 'wayland' 'libxkbcommon' 'mesa')
makedepends=('rust' 'cargo')
source=()

build() {
  cd "$startdir/.."
  cargo build --workspace --release --locked
}

check() {
  cd "$startdir/.."
  cargo test --workspace --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 "target/release/chemcraft" "$pkgdir/usr/bin/chemcraft"
  install -Dm755 "target/release/chemcraft-cli" "$pkgdir/usr/bin/chemcraft-cli"
  install -Dm644 "packaging/chemcraft.desktop" "$pkgdir/usr/share/applications/chemcraft.desktop"
  install -Dm644 "packaging/chemcraft.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/chemcraft.svg"
  install -Dm644 "LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
